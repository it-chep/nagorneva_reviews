HTTP_ADDR=:8080
GRPC_ADDR=:7002
# Set true only for local development: all admin HTTP and gRPC calls skip JWT authorization.
DEBUG=false
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=reviews
POSTGRES_PASSWORD=reviews
POSTGRES_DB=reviews
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_TTL=24h
# Yandex Object Storage. Create the bucket beforehand and keep credentials in .env only.
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=your-yandex-object-storage-bucket
S3_ACCESS_KEY=replace-with-static-access-key
S3_SECRET_KEY=replace-with-static-secret-key
# Leave blank to use https://storage.yandexcloud.net/<S3_BUCKET>.
S3_PUBLIC_URL=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-starting
