HTTP_ADDR=:8080
GRPC_ADDR=:7002
# Set true only for local development: all admin HTTP and gRPC calls skip JWT authorization.
DEBUG=false
# Comma-separated exact browser origins allowed to call the HTTP API.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=reviews
POSTGRES_PASSWORD=reviews
POSTGRES_DB=reviews
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_TTL=24h
# Photo uploads are temporarily disabled: keep S3_BUCKET empty.
# To enable Yandex Object Storage later, set an existing bucket and its credentials in .env.
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Leave blank to use https://storage.yandexcloud.net/<S3_BUCKET>.
S3_PUBLIC_URL=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-starting
